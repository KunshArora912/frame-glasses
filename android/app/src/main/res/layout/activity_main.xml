<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Frame"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:paddingBottom="12dp" />

        <!-- G2 hub mode: which host holds the Even G2 glasses -->
        <LinearLayout style="@style/Card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Even G2 hub" android:textStyle="bold" android:textColor="@color/text" />
            <RadioGroup android:id="@+id/hubMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:id="@+id/hubLaptop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hub: Laptop" android:textColor="@color/text" android:paddingEnd="16dp" />
                <RadioButton android:id="@+id/hubPhone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phone" android:textColor="@color/text" />
            </RadioGroup>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:text="Only one host can hold the glasses. Laptop: g2/run.py holds them and this phone forwards notifications and GPS. Phone: this phone holds both arms itself (stop the laptop gateway first)." />
        </LinearLayout>

        <!-- G2 phone hub card (Phone mode) -->
        <LinearLayout style="@style/Card" android:id="@+id/phoneHubCard" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="G2 phone hub" android:textStyle="bold" android:textColor="@color/text" />
                    <TextView android:id="@+id/phoneHubText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="off" android:textColor="@color/muted" android:textSize="13sp" />
                </LinearLayout>
                <Button android:id="@+id/phoneHubBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connect" />
            </LinearLayout>
            <TextView android:id="@+id/phoneHubArms" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Left: -   Right: -   Battery: -" android:textColor="@color/text" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp">
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/phoneNotifSwitch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Phone notifications to the glasses" android:textColor="@color/text" android:textSize="13sp" />
                <Button android:id="@+id/phoneAccessBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Access" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/phoneNotifText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:text="Last notification: none yet" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:text="Talks to the glasses directly over Bluetooth (g2core). Even\'s dashboard stays as Even had it: no board page, no menu change, no widget push unless you switch a dashboard feature on below. Double tap on the glasses closes things. Even\'s servers are never contacted." />
        </LinearLayout>

        <!-- Ask questions (Even AI replacement, Phone mode) -->
        <LinearLayout style="@style/Card" android:id="@+id/askCard" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ask questions (Even AI)" android:textStyle="bold" android:textColor="@color/text" />
            <TextView android:id="@+id/aiText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Even AI: waiting" android:textColor="@color/text" android:textSize="13sp" />
            <TextView android:id="@+id/micText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#FFFF9900" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@+id/keyInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="Claude API key" android:inputType="textPassword" android:textColor="@color/text" android:textColorHint="@color/muted" android:importantForAutofill="no" />
                <Button android:id="@+id/keySaveBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save" android:textSize="12sp" />
                <Button android:id="@+id/keyClearBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/keyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="no key" android:textColor="@color/text" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:text="Pick Even AI on the glasses (or your long-press gesture), then speak. The PHONE microphone hears the question (the glasses\' mic sends LC3 audio, which this app does not decode yet). Only the question text goes to Anthropic\'s API; calendar, ideas and everything else stay on the phone. Claude can add and list calendar events, save ideas and look up stock prices. Double tap on the glasses closes the answer." />
        </LinearLayout>

        <!-- Dashboard features (Phone mode), all off by default -->
        <LinearLayout style="@style/Card" android:id="@+id/featuresCard" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard features" android:textStyle="bold" android:textColor="@color/text" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:text="All off by default. Nothing is pushed to a dashboard card unless you switch it on here. Switching off stops pushing; the glasses keep what they last showed." />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/featStocks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stocks on dashboard (every 15 min)" android:textColor="@color/text" android:paddingTop="6dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@+id/tickersInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="AAPL, MSFT (max 5)" android:inputType="textCapCharacters" android:textColor="@color/text" android:textColorHint="@color/muted" android:importantForAutofill="no" />
                <Button android:id="@+id/tickersSaveBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/featStocksText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:text="off" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/featCalendar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Calendar on dashboard (today + tomorrow)" android:textColor="@color/text" android:paddingTop="6dp" />
            <TextView android:id="@+id/featCalendarText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:text="off" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/featIdeas" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ideas on dashboard (quick list)" android:textColor="@color/text" android:paddingTop="6dp" />
            <TextView android:id="@+id/featIdeasText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:text="off" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp">
                <TextView android:id="@+id/calText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Calendar: -" android:textColor="@color/text" android:textSize="13sp" />
                <Button android:id="@+id/calChooseBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/ideasCountText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:text="Ideas saved on this phone: 0" />
        </LinearLayout>

        <!-- G2 laptop link card: notifications + GPS to g2/phone_link.py; never touches Bluetooth -->
        <LinearLayout style="@style/Card" android:id="@+id/g2LaptopCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="G2 laptop link" android:textStyle="bold" android:textColor="@color/text" />
                    <TextView android:id="@+id/g2Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="off" android:textColor="@color/muted" android:textSize="13sp" />
                </LinearLayout>
                <Button android:id="@+id/g2Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connect" />
            </LinearLayout>
            <EditText
                android:id="@+id/g2Url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ws://localhost:8768/phone"
                android:inputType="textUri"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:importantForAutofill="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/g2AccessText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="" android:textColor="@color/text" android:textSize="13sp" />
                <Button android:id="@+id/g2AccessBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notification access" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/g2NotifText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Last notification: none yet" android:textColor="@color/muted" android:textSize="13sp" />
            <TextView android:id="@+id/g2FixText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Last GPS fix: none yet" android:textColor="@color/muted" android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="For the Even G2: the laptop holds the glasses\' Bluetooth; this phone only forwards its notifications and GPS. Over USB the laptop runs adb reverse tcp:8768 tcp:8768. While this link is on, the Frame Connect below is refused."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- G2 Display card (visible while the G2 laptop link is on): synced both ways through the laptop -->
        <LinearLayout style="@style/Card" android:id="@+id/displayCard" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Display" android:textStyle="bold" android:textColor="@color/text" />
            <TextView android:id="@+id/glassesBattery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Glasses: waiting for the laptop" android:textColor="@color/muted" android:textSize="13sp" android:paddingBottom="8dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Display Height: vertical slider (a rotated SeekBar in a narrow frame) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingEnd="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Display\nHeight" android:gravity="center" android:textColor="@color/text" android:textSize="13sp" />
                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="200dp"
                        android:clipChildren="false">
                        <SeekBar
                            android:id="@+id/heightBar"
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:rotation="270"
                            android:max="20" />
                    </FrameLayout>
                    <TextView android:id="@+id/heightVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Display Distance" android:textColor="@color/text" android:textSize="13sp" />
                        <TextView android:id="@+id/distanceVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/nearBtn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Near" android:textSize="12sp" />
                        <Button android:id="@+id/midBtn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Mid" android:textSize="12sp" />
                        <Button android:id="@+id/farBtn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Far" android:textSize="12sp" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/distanceBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="20" android:paddingTop="8dp" android:paddingBottom="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Brightness" android:textColor="@color/text" android:textSize="13sp" />
                        <TextView android:id="@+id/brightVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text" android:paddingEnd="8dp" />
                        <androidx.appcompat.widget.SwitchCompat android:id="@+id/autoSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto" android:textColor="@color/text" />
                    </LinearLayout>
                    <SeekBar android:id="@+id/brightBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" android:paddingTop="8dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="Laptop mode: read through the laptop every 10 s and after each change. Phone mode: read directly every 60 s and after each change."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- link card -->
        <LinearLayout style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/bleText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Not connected"
                    android:textColor="@color/muted" />
                <Button android:id="@+id/connectBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connect" />
                <Button android:id="@+id/disconnectBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Disconnect" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Frame bonds with one host. If the laptop is bonded, do the cradle-pin reset first, then Connect here and accept the pairing prompt."
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
                <Button android:id="@+id/forgetBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Forget" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- status card -->
        <LinearLayout style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/pctText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:textColor="@color/text"
                    android:paddingEnd="16dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:id="@+id/stateText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="waiting for the glasses to report" android:textColor="@color/text" />
                    <TextView android:id="@+id/fwText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/muted" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <ProgressBar
                android:id="@+id/bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0" />
            <TextView android:id="@+id/seenText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/muted" android:textSize="13sp" />
        </LinearLayout>

        <!-- relay card -->
        <LinearLayout style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/relayText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Laptop relay" android:textColor="@color/text" />
                <Button android:id="@+id/relayBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Link" />
            </LinearLayout>
            <EditText
                android:id="@+id/relayUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ws://laptop-ip:8765/phone"
                android:inputType="textUri"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:importantForAutofill="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="While linked, programs on the laptop use this phone's Bluetooth. Pick an app on the glasses, or here:"
                android:textColor="@color/muted"
                android:textSize="13sp" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/appsRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- console card -->
        <LinearLayout style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/luaInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="Lua, e.g. print(frame.battery_level())"
                    android:inputType="text"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:importantForAutofill="no" />
                <Button android:id="@+id/sendBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/breakBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Break" />
                <Button android:id="@+id/resetBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wake screen" />
                <Button android:id="@+id/clearBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear log" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Break stops main.lua so the REPL answers; Wake screen starts it again."
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#FF000000">
            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="@color/text" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
