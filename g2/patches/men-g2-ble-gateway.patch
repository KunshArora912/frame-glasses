+def validate_raw_frame(frame: bytes) -> bytes:
+    """Check that frame is one complete G2 BLE packet; return it unchanged.
+
+    The check only looks at the framing header (0xAA, declared payload length);
+    seq, CRC and payload are passed through untouched.
+    """
+
+    if len(frame) < RAW_FRAME_MIN_LENGTH:
+        raise ValueError(f"frame must be at least {RAW_FRAME_MIN_LENGTH} bytes (got {len(frame)})")
+    if frame[0] != RAW_FRAME_HEADER_BYTE:
