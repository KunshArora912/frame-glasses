+class RawEventTests(unittest.IsolatedAsyncioTestCase):
+    FRAME = bytes.fromhex("aa1201040101e0000802abcd")  # glasses->phone EvenHub cmd 2 (consumed by gateway)
+    AUDIO = bytes(range(50))
+
+    async def _notify(self, h: Harness, data: bytes, source: str = "R", char: str = "5402") -> None:
+        gen = h.client._connection_generation
+        side_gen = h.client._side_generations["left" if source == "L" else "right"]
+        await h.client._handle_notification(data, source, char, gen, side_gen)
+
+    async def test_raw_events_off_by_default(self) -> None:
+        h = Harness()
+        await self._notify(h, self.FRAME)
+        self.assertEqual(h.kinds("glasses.raw_packet"), [])
+
+    async def test_raw_events_emitted_for_consumed_frames(self) -> None:
+        h = Harness(raw_events=True)
+        await self._notify(h, self.FRAME, source="L")
+        raw = h.kinds("glasses.raw_packet")
+        self.assertEqual(len(raw), 1)
+        self.assertEqual(raw[0]["source"], "L")
+        self.assertEqual(raw[0]["size"], len(self.FRAME))
+        self.assertEqual(raw[0]["hex"], self.FRAME.hex())
+        self.assertEqual(raw[0]["char"], "5402")
+
+    async def test_debug_raw_events_is_an_alias(self) -> None:
+        h = Harness(debug_raw_events=True)
+        await self._notify(h, self.FRAME)
+        self.assertEqual(len(h.kinds("glasses.raw_packet")), 1)
+
+    async def test_audio_needs_separate_flag(self) -> None:
+        h = Harness(raw_events=True)
+        await self._notify(h, self.AUDIO, char="6402")
+        self.assertEqual(h.kinds("glasses.raw_packet"), [])
+        self.assertEqual(len(h.kinds("glasses.mic_audio")), 1)
+
+        h2 = Harness(raw_events=True, raw_events_audio=True)
+        await self._notify(h2, self.AUDIO, char="6402")
+        raw = h2.kinds("glasses.raw_packet")
+        self.assertEqual(len(raw), 1)
+        self.assertEqual(raw[0]["char"], "6402")
+
+    async def test_stale_generation_is_ignored(self) -> None:
+        h = Harness(raw_events=True)
+        await h.client._handle_notification(self.FRAME, "R", "5402", h.client._connection_generation + 1, 0)
+        self.assertEqual(h.kinds("glasses.raw_packet"), [])
+
+    async def test_file_notify_7402_is_raw_only(self) -> None:
+        # EvenFile START reply [cid 0, rsp 0] on 7402: raw-only, not fed to the EvenHub parser
+        reply = bytes.fromhex("aa1201040101c40000000000")
+        h = Harness()
+        await self._notify(h, reply, char="7402")
+        self.assertEqual(h.kinds("glasses.raw_packet"), [])
+
+        h2 = Harness(raw_events=True)
+        await self._notify(h2, reply, char="7402")
+        raw = h2.kinds("glasses.raw_packet")
+        self.assertEqual(len(raw), 1)
+        self.assertEqual(raw[0]["char"], "7402")
+        self.assertEqual(raw[0]["hex"], reply.hex())
+        # nothing else was produced from it and no partial reassembly state was left behind
+        self.assertEqual([e["kind"] for e in h2.events], ["glasses.raw_packet"])
+        self.assertEqual(h2.client._receive_manager._partials, {})
+
+
+if __name__ == "__main__":
+    unittest.main()
