+from __future__ import annotations
+
+import unittest
+
+from mentraos.g2.constants import OsEventType
+from mentraos.g2.events import map_event_type_to_gesture, parse_even_hub_response
+from tests._support import sys_event_payload, text_event_payload
+
+
+class GestureMappingTests(unittest.TestCase):
+    def test_long_press_event_types_exist(self) -> None:
+        self.assertEqual(OsEventType.from_int(9), OsEventType.LONG_PRESS)
+        self.assertEqual(OsEventType.from_int(10), OsEventType.LONG_PRESS_RELEASE)
+
+    def test_long_press_maps_to_gesture_names(self) -> None:
+        self.assertEqual(map_event_type_to_gesture(OsEventType.LONG_PRESS), "long_press")
+        self.assertEqual(map_event_type_to_gesture(OsEventType.LONG_PRESS_RELEASE), "long_press_release")
+
+    def test_existing_gestures_unchanged(self) -> None:
+        self.assertEqual(map_event_type_to_gesture(OsEventType.CLICK), "single_tap")
+        self.assertEqual(map_event_type_to_gesture(OsEventType.DOUBLE_CLICK), "double_tap")
+        self.assertEqual(map_event_type_to_gesture(OsEventType.SCROLL_TOP), "swipe_up")
+        self.assertEqual(map_event_type_to_gesture(OsEventType.SCROLL_BOTTOM), "swipe_down")
+        self.assertIsNone(map_event_type_to_gesture(OsEventType.IMU_DATA_REPORT))
+
+    def test_sys_event_long_press_parses_to_touch_event(self) -> None:
+        parsed = parse_even_hub_response(sys_event_payload(9, source=1))
+        self.assertEqual(parsed["cmd"], 2)
+        self.assertEqual(
+            parsed["events"],
+            [{"kind": "glasses.touch", "data": {"gesture": "long_press", "source": 1}}],
+        )
+        self.assertFalse(parsed["system_exit"])
+        self.assertFalse(parsed["page_shutdown"])
+
+    def test_text_event_long_press_release_parses_to_touch_event(self) -> None:
+        parsed = parse_even_hub_response(text_event_payload(10))
+        self.assertEqual(parsed["events"], [{"kind": "glasses.touch", "data": {"gesture": "long_press_release"}}])
+
+    def test_unknown_event_type_is_dropped(self) -> None:
+        parsed = parse_even_hub_response(sys_event_payload(42))
+        self.assertEqual(parsed["events"], [])
+
+
+class GestureAllowListTests(unittest.TestCase):
+    def test_http_touch_allow_list_includes_long_press(self) -> None:
+        from tests._support import restore_real_modules
+
+        restore_real_modules()
+        import gateway_server
+
+        self.assertIn("long_press", gateway_server.VALID_TOUCH_GESTURES)
+        self.assertIn("long_press_release", gateway_server.VALID_TOUCH_GESTURES)
+        self.assertTrue({"single_tap", "double_tap", "swipe_up", "swipe_down"} <= gateway_server.VALID_TOUCH_GESTURES)
+
+    def test_mcp_wait_for_touch_allow_list_includes_long_press(self) -> None:
+        import gateway_mcp
+
+        self.assertEqual(gateway_mcp._normalize_gestures(["long_press", "long_press_release"]), {"long_press", "long_press_release"})
+        # choice/menu mappings keep the original four gestures
+        self.assertEqual(gateway_mcp.CHOICE_GESTURES, ["single_tap", "double_tap", "swipe_up", "swipe_down"])
+
+
+if __name__ == "__main__":
+    unittest.main()
