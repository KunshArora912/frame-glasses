+        self.assertEqual(h.state.display_surface, DISPLAY_SURFACE_DASHBOARD)
+        self.assertFalse(h.state.parked, "system_exit never parks; only page_shutdown does")
+
+    async def test_foreground_echo_right_after_parking_is_ignored(self) -> None:
