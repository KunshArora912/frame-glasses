+class Harness:
+    """A ready G2Client whose BLE writes are captured instead of sent."""
+
+    def __init__(self, **config: Any) -> None:
+        self.events: list[dict[str, Any]] = []
+        self.sent: list[bytes] = []
+        self.client = G2Client(G2ClientConfig(ble_packet_gap_ms=0, **config), event_handler=self._on_event)
+        self.left, self.right = FakeBleakClient("left"), FakeBleakClient("right")
+        self.client._left_client = self.left
+        self.client._right_client = self.right
+        state = self.client._state
+        state.left.connected = True
+        state.right.connected = True
+        state.ready = True
+        state.phase = ConnectionPhase.READY
+        # pretend the init sequence created the startup page
+        state.page.startup_page_created = True
+        state.page.page_created = True
+        state.page.page_has_text_container = True
+        state.page.page_has_fullscreen_text_container = True
+        state.display_surface = DISPLAY_SURFACE_APP
+
+        async def capture(payload: bytes, urgent: bool = False) -> None:
+            self.sent.append(payload)
+
+        self.client._send_even_hub_command = capture  # type: ignore[method-assign]
+
+    async def _on_event(self, event: dict[str, Any]) -> None:
+        self.events.append(event)
+
+    def kinds(self, kind: str) -> list[dict[str, Any]]:
+        return [e["data"] for e in self.events if e["kind"] == kind]
+
+    def sent_cmds(self) -> list[int | None]:
+        return [even_hub_cmd(p) for p in self.sent]
+
+    @property
+    def state(self):
+        return self.client._state
+
