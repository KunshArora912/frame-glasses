+from mentraos.g2.constants import CHAR_WRITE, FILE_WRITE  # noqa: E402
+
+PRELUDE_HEX = "aa219213010101200802109c01220a1a081206120408001000a142"
+KEEPALIVE_HEX = "aa21050801018000080e10056a00" + "0000"  # 8-byte payload incl. CRC placeholder
+
+
+class ParseRawRequestTests(unittest.TestCase):
+    def test_single_hex_frame(self) -> None:
+        side, frames, response, char = gateway_server.parse_raw_request({"side": "right", "hex": PRELUDE_HEX})
+        self.assertEqual(side, "right")
+        self.assertEqual(frames, [bytes.fromhex(PRELUDE_HEX)])
+        self.assertFalse(response)
+        self.assertEqual(char, "5401")
+
+    def test_hex_is_passed_through_unchanged(self) -> None:
+        # Deliberately wrong CRC / odd seq: the gateway must not touch them.
+        frame = "aa21ff0a0101e020080c10ff72020800beef"
+        _, frames, _, _ = gateway_server.parse_raw_request({"side": "left", "hex": frame})
+        self.assertEqual(frames[0].hex(), frame)
+
+    def test_accepts_whitespace_uppercase_and_0x_prefix(self) -> None:
+        spaced = "0x" + " ".join(PRELUDE_HEX[i : i + 2] for i in range(0, len(PRELUDE_HEX), 2)).upper()
+        _, frames, _, _ = gateway_server.parse_raw_request({"side": "both", "hex": spaced})
+        self.assertEqual(frames[0].hex(), PRELUDE_HEX)
+
+    def test_frames_list_preserves_order(self) -> None:
+        second = "aa21060801018000080e10066a000000"
+        _, frames, _, _ = gateway_server.parse_raw_request({"side": "both", "frames": [KEEPALIVE_HEX, second]})
+        self.assertEqual([f.hex() for f in frames], [KEEPALIVE_HEX, second])
+
+    def test_response_flag(self) -> None:
+        _, _, response, _ = gateway_server.parse_raw_request({"side": "left", "hex": PRELUDE_HEX, "response": True})
+        self.assertTrue(response)
+        with self.assertRaisesRegex(ValueError, "response must be a boolean"):
+            gateway_server.parse_raw_request({"side": "left", "hex": PRELUDE_HEX, "response": "yes"})
+
+    def test_char_field(self) -> None:
+        _, _, _, char = gateway_server.parse_raw_request({"side": "right", "hex": PRELUDE_HEX, "char": "7401"})
+        self.assertEqual(char, "7401")
+        _, _, _, char = gateway_server.parse_raw_request({"side": "right", "hex": PRELUDE_HEX, "char": " 0x5401 "})
+        self.assertEqual(char, "5401")
+        for bad in ("5402", "7402", "6401", "", "abcd", 7401, None):
+            with self.subTest(bad=bad), self.assertRaisesRegex(ValueError, "char must be"):
+                gateway_server.parse_raw_request({"side": "right", "hex": PRELUDE_HEX, "char": bad})
+
+    def test_rejects_bad_side(self) -> None:
+        with self.assertRaisesRegex(ValueError, "side must be one of"):
+            gateway_server.parse_raw_request({"side": "middle", "hex": PRELUDE_HEX})
+        with self.assertRaisesRegex(ValueError, "side must be one of"):
+            gateway_server.parse_raw_request({"hex": PRELUDE_HEX})
+
+    def test_rejects_bad_hex(self) -> None:
+        for bad in ("", "abc", "zz21000000000000", 123, None):
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                gateway_server.parse_raw_request({"side": "right", "hex": bad})
+
+    def test_rejects_non_frame_bytes(self) -> None:
+        with self.assertRaisesRegex(ValueError, "start with 0xAA"):
+            gateway_server.parse_raw_request({"side": "right", "hex": "bb2100000101e020"})
+        with self.assertRaisesRegex(ValueError, "at least 8 bytes"):
+            gateway_server.parse_raw_request({"side": "right", "hex": "aa210000"})
+        # header says 0x13 (19) payload bytes but only 2 follow
+        with self.assertRaisesRegex(ValueError, "does not match header length"):
+            gateway_server.parse_raw_request({"side": "right", "hex": "aa219213010101200802"})
+        # two concatenated frames in one hex string
+        with self.assertRaisesRegex(ValueError, "separate frames"):
+            gateway_server.parse_raw_request({"side": "right", "hex": PRELUDE_HEX + PRELUDE_HEX})
+
+    def test_rejects_missing_or_mixed_payload(self) -> None:
+        with self.assertRaisesRegex(ValueError, "requires hex or frames"):
+            gateway_server.parse_raw_request({"side": "right"})
+        with self.assertRaisesRegex(ValueError, "not both"):
+            gateway_server.parse_raw_request({"side": "right", "hex": PRELUDE_HEX, "frames": [PRELUDE_HEX]})
+        with self.assertRaisesRegex(ValueError, "non-empty list"):
+            gateway_server.parse_raw_request({"side": "right", "frames": []})
+        with self.assertRaisesRegex(ValueError, "must be a JSON object"):
+            gateway_server.parse_raw_request([PRELUDE_HEX])
+
+    def test_validate_raw_frame_returns_same_bytes(self) -> None:
+        raw = bytes.fromhex(PRELUDE_HEX)
+        self.assertEqual(validate_raw_frame(bytearray(raw)), raw)
+
