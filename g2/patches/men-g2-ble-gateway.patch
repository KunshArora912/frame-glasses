+class HeartbeatPauseTests(unittest.IsolatedAsyncioTestCase):
+    """While parked the EvenHub heartbeat (cmd 12) is held; it resumes when the page returns."""
+
+    HEARTBEAT = int(EvenHubCmd.HEARTBEAT)
+    INTERVAL = 0.005
+    WINDOW = 0.15  # several intervals even with Windows' ~16 ms timer granularity
+
+    def _start_loop(self, h: Harness) -> asyncio.Task[None]:
+        return asyncio.create_task(h.client._even_hub_heartbeat_loop(h.client._connection_generation))
+
+    async def _stop_loop(self, task: asyncio.Task[None]) -> None:
+        task.cancel()
+        with suppress(asyncio.CancelledError):
+            await task
+
+    async def _heartbeats_in_window(self, h: Harness) -> int:
+        h.sent.clear()
+        await asyncio.sleep(self.WINDOW)
+        return h.sent_cmds().count(self.HEARTBEAT)
+
+    def test_effective_setting_follows_park_on_exit_by_default(self) -> None:
+        self.assertFalse(Harness().client.park_stops_heartbeat)
+        self.assertTrue(Harness(park_on_exit=True).client.park_stops_heartbeat)
+        self.assertFalse(Harness(park_on_exit=True, park_stops_heartbeat=False).client.park_stops_heartbeat)
+        self.assertTrue(Harness(park_stops_heartbeat=True).client.park_stops_heartbeat)
+        # not parked -> never paused, whatever the flag says
+        self.assertFalse(Harness(park_stops_heartbeat=True).client._heartbeat_paused())
+
+    async def test_heartbeat_stops_while_parked_and_resumes_on_create(self) -> None:
+        h = Harness(park_on_exit=True, heartbeat_interval_sec=self.INTERVAL)
+        task = self._start_loop(h)
+        try:
+            self.assertGreater(await self._heartbeats_in_window(h), 0, "heartbeat runs before parking")
+
+            await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+            self.assertTrue(h.state.parked)
+            self.assertTrue(h.client._heartbeat_paused())
+            self.assertEqual(await self._heartbeats_in_window(h), 0, "no heartbeat while parked")
+            self.assertFalse(task.done(), "the heartbeat task must stay alive (no reconnect watchdog trip)")
+
+            await h.client.create_page()
+            self.assertFalse(h.state.parked)
+            self.assertGreater(await self._heartbeats_in_window(h), 0, "heartbeat resumes after page create")
+        finally:
+            await self._stop_loop(task)
+
+    async def test_heartbeat_resumes_on_display_request_and_menu_launch(self) -> None:
+        # /api/display path
+        h = Harness(park_on_exit=True, heartbeat_interval_sec=self.INTERVAL)
+        task = self._start_loop(h)
+        try:
+            await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+            self.assertEqual(await self._heartbeats_in_window(h), 0)
+            await h.client.display({"text": "back"})
+            self.assertGreater(await self._heartbeats_in_window(h), 0)
+        finally:
+            await self._stop_loop(task)
+
+        # dashboard menu launch path
+        h2 = Harness(park_on_exit=True, heartbeat_interval_sec=self.INTERVAL)
+        task2 = self._start_loop(h2)
+        try:
+            await h2.client._handle_even_hub_payload(page_shutdown_payload(9))
+            self.assertEqual(await self._heartbeats_in_window(h2), 0)
+            await h2.client._handle_even_hub_payload(menu_select_payload(h2.client._launch_menu_app_id))
+            self.assertFalse(h2.state.parked)
+            self.assertGreater(await self._heartbeats_in_window(h2), 0)
+        finally:
+            await self._stop_loop(task2)
+
+    async def test_heartbeat_keeps_running_while_parked_when_disabled(self) -> None:
+        h = Harness(park_on_exit=True, park_stops_heartbeat=False, heartbeat_interval_sec=self.INTERVAL)
+        task = self._start_loop(h)
+        try:
+            await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+            self.assertTrue(h.state.parked)
+            self.assertGreater(await self._heartbeats_in_window(h), 0)
+        finally:
+            await self._stop_loop(task)
+
+    async def test_explicit_shutdown_without_park_on_exit_needs_the_flag(self) -> None:
+        # park_on_exit off: /api/page shutdown parks, heartbeat continues unless asked otherwise
+        h = Harness(heartbeat_interval_sec=self.INTERVAL)
+        task = self._start_loop(h)
+        try:
+            await h.client.shutdown_page()
+            self.assertTrue(h.state.parked)
+            self.assertGreater(await self._heartbeats_in_window(h), 0)
+        finally:
+            await self._stop_loop(task)
+
+        h2 = Harness(park_stops_heartbeat=True, heartbeat_interval_sec=self.INTERVAL)
+        task2 = self._start_loop(h2)
+        try:
+            await h2.client.shutdown_page()
+            self.assertTrue(h2.state.parked)
+            self.assertEqual(await self._heartbeats_in_window(h2), 0)
+        finally:
+            await self._stop_loop(task2)
+
