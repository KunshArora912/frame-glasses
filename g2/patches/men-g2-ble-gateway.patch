new file mode 100644
index 0000000..23696c0
--- /dev/null
+++ b/tests/test_park_state.py
@@ -0,0 +1,313 @@
+from __future__ import annotations
+
+import unittest
+from typing import Any
+
+from tests._support import (
+    FakeBleakClient,
+    even_hub_cmd,
+    menu_select_payload,
+    page_shutdown_payload,
+    restore_real_modules,
+    sys_event_payload,
+)
+
+restore_real_modules()
+
+from mentraos.g2.client import (  # noqa: E402
+    DISPLAY_SURFACE_APP,
+    DISPLAY_SURFACE_DASHBOARD,
+    G2Client,
+    G2ClientConfig,
+    G2NotConnectedError,
+)
+from mentraos.g2.constants import EvenHubCmd  # noqa: E402
+from mentraos.g2.state import ConnectionPhase  # noqa: E402
+
+
+class Harness:
+    """A ready G2Client whose BLE writes are captured instead of sent."""
+
+    def __init__(self, **config: Any) -> None:
+        self.events: list[dict[str, Any]] = []
+        self.sent: list[bytes] = []
+        self.client = G2Client(G2ClientConfig(ble_packet_gap_ms=0, **config), event_handler=self._on_event)
+        self.left, self.right = FakeBleakClient("left"), FakeBleakClient("right")
+        self.client._left_client = self.left
+        self.client._right_client = self.right
+        state = self.client._state
+        state.left.connected = True
+        state.right.connected = True
+        state.ready = True
+        state.phase = ConnectionPhase.READY
+        # pretend the init sequence created the startup page
+        state.page.startup_page_created = True
+        state.page.page_created = True
+        state.page.page_has_text_container = True
+        state.page.page_has_fullscreen_text_container = True
+        state.display_surface = DISPLAY_SURFACE_APP
+
+        async def capture(payload: bytes, urgent: bool = False) -> None:
+            self.sent.append(payload)
+
+        self.client._send_even_hub_command = capture  # type: ignore[method-assign]
+
+    async def _on_event(self, event: dict[str, Any]) -> None:
+        self.events.append(event)
+
+    def kinds(self, kind: str) -> list[dict[str, Any]]:
+        return [e["data"] for e in self.events if e["kind"] == kind]
+
+    def sent_cmds(self) -> list[int | None]:
+        return [even_hub_cmd(p) for p in self.sent]
+
+    @property
+    def state(self):
+        return self.client._state
+
+
+class ParkOnExitTests(unittest.IsolatedAsyncioTestCase):
+    async def test_page_shutdown_parks_and_does_not_recreate(self) -> None:
+        h = Harness(park_on_exit=True)
+
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+
+        self.assertTrue(h.state.parked)
+        self.assertEqual(h.state.display_surface, DISPLAY_SURFACE_DASHBOARD)
+        self.assertFalse(h.state.page.page_created)
+        self.assertFalse(h.state.mic_enabled)
+        self.assertEqual(h.sent, [], "no page create/rebuild may be sent while parked")
+        reinit = h.kinds("system.reinitialize")
+        self.assertEqual(len(reinit), 1)
+        self.assertEqual(reinit[0]["reason"], "page_parked")
+        status = h.client.get_status()
+        self.assertTrue(status["parked"])
+        self.assertEqual(status["display_surface"], "dashboard")
+
+    async def test_error_code_9_ack_also_parks(self) -> None:
+        from mentraos.g2.protobuf import ProtobufWriter
+
+        h = Harness(park_on_exit=True)
+        inner = ProtobufWriter()
+        inner.write_int32_field(1, 9)
+        writer = ProtobufWriter()
+        writer.write_int32_field(1, int(EvenHubCmd.UPDATE_TEXT_DATA))
+        writer.write_message_field(6, inner.to_bytes())
+
+        await h.client._handle_even_hub_payload(writer.to_bytes())
+
+        self.assertTrue(h.state.parked)
+        self.assertEqual(h.sent, [])
+
+    async def test_repeated_shutdown_while_parked_emits_once(self) -> None:
+        h = Harness(park_on_exit=True)
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+        await h.client._handle_even_hub_payload(page_shutdown_payload(10))
+
+        self.assertEqual(len(h.kinds("system.reinitialize")), 1)
+        self.assertTrue(h.state.parked)
+
+    async def test_display_request_recreates_page_then_renders(self) -> None:
+        h = Harness(park_on_exit=True)
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+        h.events.clear()
+
+        result = await h.client.display({"text": "hello"})
+
+        self.assertEqual(result["mode"], "fast_text")
+        self.assertFalse(h.state.parked)
+        self.assertEqual(h.state.display_surface, DISPLAY_SURFACE_APP)
+        self.assertEqual(h.sent_cmds(), [int(EvenHubCmd.CREATE_STARTUP_PAGE)], "full startup page create, not rebuild")
+        self.assertTrue(h.state.page.page_created)
+        self.assertEqual(h.state.page.current_text_content, "hello")
+        reasons = [d["reason"] for d in h.kinds("system.reinitialize")]
+        self.assertEqual(reasons, ["display_request"])
+
+    async def test_layout_display_request_recreates_page(self) -> None:
+        h = Harness(park_on_exit=True)
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+
+        await h.client.display({"elements": [{"type": "text", "text": "a", "x": 0, "y": 0, "width": 100, "height": 50}]})
+
+        self.assertFalse(h.state.parked)
+        self.assertEqual(h.sent_cmds(), [int(EvenHubCmd.CREATE_STARTUP_PAGE)])
+
+    async def test_launch_menu_recreates_page_and_emits_launch_events(self) -> None:
+        h = Harness(park_on_exit=True)
+        h.state.page.last_display_request = {"text": "cached"}
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+        h.events.clear()
+
+        await h.client._handle_even_hub_payload(menu_select_payload(h.client._launch_menu_app_id))
+
+        self.assertFalse(h.state.parked)
+        dashboard = h.kinds("glasses.dashboard")
+        self.assertEqual(dashboard[0], {"action": "selected", "app_id": h.client._launch_menu_app_id})
+        self.assertEqual(dashboard[1]["action"], "launched")
+        self.assertEqual(dashboard[1]["app_id"], h.client._launch_menu_app_id)
+        reinit = h.kinds("system.reinitialize")
+        self.assertEqual(reinit[0]["reason"], "dashboard_launch")
+        self.assertEqual(h.sent_cmds(), [int(EvenHubCmd.CREATE_STARTUP_PAGE)])
+        # cached fast-text content was re-queued for the text queue loop
+        self.assertEqual(h.state.page.current_text_content, "cached")
+
+    async def test_invalid_display_request_stays_parked(self) -> None:
+        h = Harness(park_on_exit=True)
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+
+        with self.assertRaises(ValueError):
+            await h.client.display({"text": "x" * 1001})
+
+        self.assertTrue(h.state.parked)
+        self.assertEqual(h.state.display_surface, DISPLAY_SURFACE_DASHBOARD)
+        self.assertEqual(h.sent, [])
+
+    async def test_other_menu_app_does_not_unpark(self) -> None:
+        h = Harness(park_on_exit=True)
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+
+        await h.client._handle_even_hub_payload(menu_select_payload(h.client._launch_menu_app_id + 1))
+
+        self.assertTrue(h.state.parked)
+        self.assertEqual(h.sent, [])
+
+    async def test_api_page_create_recreates_page(self) -> None:
+        h = Harness(park_on_exit=True)
+        h.state.page.last_display_request = {"text": "again"}
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+        h.events.clear()
+
+        result = await h.client.create_page()
+
+        self.assertEqual(result, {"accepted": True, "action": "create", "parked": False})
+        self.assertFalse(h.state.parked)
+        self.assertEqual(h.sent_cmds(), [int(EvenHubCmd.CREATE_STARTUP_PAGE)])
+        self.assertEqual([d["reason"] for d in h.kinds("system.reinitialize")], ["page_create"])
+        self.assertEqual(h.state.page.current_text_content, "again")
+
+    async def test_api_page_shutdown_sends_cmd9_and_parks(self) -> None:
+        h = Harness(park_on_exit=True)
+
+        result = await h.client.shutdown_page()
+
+        self.assertEqual(result["action"], "shutdown")
+        self.assertTrue(result["parked"])
+        self.assertEqual(h.sent_cmds(), [int(EvenHubCmd.SHUTDOWN_PAGE)])
+        self.assertTrue(h.state.parked)
+        self.assertEqual([d["reason"] for d in h.kinds("system.reinitialize")], ["page_parked"])
+        with self.assertRaises(ValueError):
+            await h.client.shutdown_page(exit_mode=3)
+
+    async def test_mic_request_while_parked_is_deferred(self) -> None:
+        h = Harness(park_on_exit=True)
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+
+        await h.client.set_mic_enabled(True)
+
+        self.assertTrue(h.state.target_mic_enabled)
+        self.assertFalse(h.state.mic_enabled)
+        self.assertEqual(h.sent, [], "no page create or audio control while parked")
+
+        await h.client.create_page()
+        self.assertIn(int(EvenHubCmd.AUDIO_CONTROL), h.sent_cmds())
+        self.assertTrue(h.state.mic_enabled)
+
+    async def test_not_ready_page_requests_raise_not_connected(self) -> None:
+        h = Harness(park_on_exit=True)
+        h.state.ready = False
+        with self.assertRaises(G2NotConnectedError):
+            await h.client.create_page()
+        with self.assertRaises(G2NotConnectedError):
+            await h.client.shutdown_page()
+
+    async def test_system_exit_gesture_still_marks_dashboard_without_parking(self) -> None:
+        h = Harness(park_on_exit=True)
+
+        await h.client._handle_even_hub_payload(sys_event_payload(7))
+
+        self.assertEqual(h.state.display_surface, DISPLAY_SURFACE_DASHBOARD)
+        self.assertFalse(h.state.parked, "only page_shutdown parks; SYSTEM_EXIT keeps legacy behaviour")
+        self.assertEqual(h.kinds("glasses.touch")[0]["gesture"], "system_exit")
+
+
+class DefaultBehaviourTests(unittest.IsolatedAsyncioTestCase):
+    async def test_page_shutdown_auto_recreates_by_default(self) -> None:
+        h = Harness()
+        h.state.page.last_display_request = {"text": "keep"}
+
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+
+        self.assertFalse(h.state.parked)
+        self.assertEqual([d["reason"] for d in h.kinds("system.reinitialize")], ["page_shutdown"])
+        self.assertEqual(h.sent_cmds(), [int(EvenHubCmd.CREATE_STARTUP_PAGE)])
+        self.assertEqual(h.state.display_surface, DISPLAY_SURFACE_APP)
+
+    async def test_explicit_shutdown_parks_even_without_flag(self) -> None:
+        h = Harness()
+
+        await h.client.shutdown_page()
+        # the glasses answer the ShutDown with cmd 9: must not auto-recreate
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+
+        self.assertTrue(h.state.parked)
+        self.assertEqual(h.sent_cmds(), [int(EvenHubCmd.SHUTDOWN_PAGE)])
+
+        await h.client.display({"text": "back"})
+        self.assertFalse(h.state.parked)
+        self.assertEqual(h.sent_cmds()[-1], int(EvenHubCmd.CREATE_STARTUP_PAGE))
+
+    async def test_status_exposes_parked_false_by_default(self) -> None:
+        h = Harness()
+        self.assertFalse(h.client.get_status()["parked"])
+        self.assertFalse(h.client.parked)
+
+
+class RawEventTests(unittest.IsolatedAsyncioTestCase):
+    FRAME = bytes.fromhex("aa1201040101e0000802abcd")  # glasses->phone EvenHub cmd 2 (consumed by gateway)
+    AUDIO = bytes(range(50))
+
+    async def _notify(self, h: Harness, data: bytes, source: str = "R", is_audio: bool = False) -> None:
+        gen = h.client._connection_generation
+        side_gen = h.client._side_generations["left" if source == "L" else "right"]
+        await h.client._handle_notification(data, source, is_audio, gen, side_gen)
+
+    async def test_raw_events_off_by_default(self) -> None:
+        h = Harness()
+        await self._notify(h, self.FRAME)
+        self.assertEqual(h.kinds("glasses.raw_packet"), [])
+
+    async def test_raw_events_emitted_for_consumed_frames(self) -> None:
+        h = Harness(raw_events=True)
+        await self._notify(h, self.FRAME, source="L")
+        raw = h.kinds("glasses.raw_packet")
+        self.assertEqual(len(raw), 1)
+        self.assertEqual(raw[0]["source"], "L")
+        self.assertEqual(raw[0]["size"], len(self.FRAME))
+        self.assertEqual(raw[0]["hex"], self.FRAME.hex())
+        self.assertEqual(raw[0]["char"], "5402")
+
+    async def test_debug_raw_events_is_an_alias(self) -> None:
+        h = Harness(debug_raw_events=True)
+        await self._notify(h, self.FRAME)
+        self.assertEqual(len(h.kinds("glasses.raw_packet")), 1)
+
+    async def test_audio_needs_separate_flag(self) -> None:
+        h = Harness(raw_events=True)
+        await self._notify(h, self.AUDIO, is_audio=True)
+        self.assertEqual(h.kinds("glasses.raw_packet"), [])
+        self.assertEqual(len(h.kinds("glasses.mic_audio")), 1)
+
+        h2 = Harness(raw_events=True, raw_events_audio=True)
+        await self._notify(h2, self.AUDIO, is_audio=True)
+        raw = h2.kinds("glasses.raw_packet")
+        self.assertEqual(len(raw), 1)
+        self.assertEqual(raw[0]["char"], "6402")
+
+    async def test_stale_generation_is_ignored(self) -> None:
+        h = Harness(raw_events=True)
+        await h.client._handle_notification(self.FRAME, "R", False, h.client._connection_generation + 1, 0)
+        self.assertEqual(h.kinds("glasses.raw_packet"), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
