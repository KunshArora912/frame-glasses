+RAW_SIDES = ("left", "right", "both")
+RAW_MAX_FRAMES = 64
+
+
+def parse_raw_request(payload: Any) -> tuple[str, list[bytes], bool]:
+    """Validate a POST /api/raw body and return (side, frames, response).
+
+    Accepts either "hex" (one frame) or "frames" (ordered list of hex frames).
+    Raises ValueError with a client-readable message for any malformed input.
+    """
+
+    if not isinstance(payload, dict):
+        raise ValueError("payload must be a JSON object")
+    side = str(payload.get("side", "")).strip().lower()
+    if side not in RAW_SIDES:
+        raise ValueError("side must be one of: left, right, both")
+    response = payload.get("response", False)
+    if not isinstance(response, bool):
+        raise ValueError("response must be a boolean")
+
+    hex_values: list[Any]
+    if "frames" in payload:
+        frames_value = payload.get("frames")
+        if not isinstance(frames_value, list) or not frames_value:
+            raise ValueError("frames must be a non-empty list of hex strings")
+        if "hex" in payload:
+            raise ValueError("use either hex or frames, not both")
+        hex_values = frames_value
+    elif "hex" in payload:
+        hex_values = [payload.get("hex")]
+    else:
+        raise ValueError("payload requires hex or frames")
+    if len(hex_values) > RAW_MAX_FRAMES:
+        raise ValueError(f"at most {RAW_MAX_FRAMES} frames per request")
+
+    frames: list[bytes] = []
+    for index, value in enumerate(hex_values):
+        if not isinstance(value, str):
+            raise ValueError(f"frame {index}: hex must be a string")
+        cleaned = "".join(value.split()).lower()
+        if cleaned.startswith("0x"):
+            cleaned = cleaned[2:]
+        if not cleaned:
+            raise ValueError(f"frame {index}: hex is empty")
+        if len(cleaned) % 2:
+            raise ValueError(f"frame {index}: hex has odd length")
+        try:
+            raw = bytes.fromhex(cleaned)
+        except ValueError as exc:
+            raise ValueError(f"frame {index}: invalid hex ({exc})") from exc
+        try:
+            frames.append(validate_raw_frame(raw))
+        except ValueError as exc:
+            raise ValueError(f"frame {index}: {exc}") from exc
+    return side, frames, response
 
 
