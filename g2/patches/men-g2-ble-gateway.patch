+from pathlib import Path
+
+from tests._support import FakeBleakClient, restore_real_modules
+
+restore_real_modules()
+
+import gateway_server  # noqa: E402  (after stub cleanup on purpose)
+from gateway_config import GatewayConfig, GatewayConfigStore  # noqa: E402
+from mentraos.g2.client import G2Client, G2ClientConfig, G2NotConnectedError, validate_raw_frame  # noqa: E402
+from mentraos.g2.constants import CHAR_WRITE  # noqa: E402
+
+PRELUDE_HEX = "aa219213010101200802109c01220a1a081206120408001000a142"
+KEEPALIVE_HEX = "aa21050801018000080e10056a00" + "0000"  # 8-byte payload incl. CRC placeholder
+
+
+class ParseRawRequestTests(unittest.TestCase):
+    def test_single_hex_frame(self) -> None:
+        side, frames, response = gateway_server.parse_raw_request({"side": "right", "hex": PRELUDE_HEX})
+        self.assertEqual(side, "right")
+        self.assertEqual(frames, [bytes.fromhex(PRELUDE_HEX)])
+        self.assertFalse(response)
+
+    def test_hex_is_passed_through_unchanged(self) -> None:
+        # Deliberately wrong CRC / odd seq: the gateway must not touch them.
+        frame = "aa21ff0a0101e020080c10ff72020800beef"
+        _, frames, _ = gateway_server.parse_raw_request({"side": "left", "hex": frame})
+        self.assertEqual(frames[0].hex(), frame)
+
+    def test_accepts_whitespace_uppercase_and_0x_prefix(self) -> None:
+        spaced = "0x" + " ".join(PRELUDE_HEX[i : i + 2] for i in range(0, len(PRELUDE_HEX), 2)).upper()
+        _, frames, _ = gateway_server.parse_raw_request({"side": "both", "hex": spaced})
+        self.assertEqual(frames[0].hex(), PRELUDE_HEX)
+
+    def test_frames_list_preserves_order(self) -> None:
+        second = "aa21060801018000080e10066a000000"
+        _, frames, _ = gateway_server.parse_raw_request({"side": "both", "frames": [KEEPALIVE_HEX, second]})
+        self.assertEqual([f.hex() for f in frames], [KEEPALIVE_HEX, second])
+
+    def test_response_flag(self) -> None:
+        _, _, response = gateway_server.parse_raw_request({"side": "left", "hex": PRELUDE_HEX, "response": True})
+        self.assertTrue(response)
+        with self.assertRaisesRegex(ValueError, "response must be a boolean"):
+            gateway_server.parse_raw_request({"side": "left", "hex": PRELUDE_HEX, "response": "yes"})
+
+    def test_rejects_bad_side(self) -> None:
+        with self.assertRaisesRegex(ValueError, "side must be one of"):
+            gateway_server.parse_raw_request({"side": "middle", "hex": PRELUDE_HEX})
+        with self.assertRaisesRegex(ValueError, "side must be one of"):
+            gateway_server.parse_raw_request({"hex": PRELUDE_HEX})
+
+    def test_rejects_bad_hex(self) -> None:
+        for bad in ("", "abc", "zz21000000000000", 123, None):
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                gateway_server.parse_raw_request({"side": "right", "hex": bad})
+
+    def test_rejects_non_frame_bytes(self) -> None:
+        with self.assertRaisesRegex(ValueError, "start with 0xAA"):
+            gateway_server.parse_raw_request({"side": "right", "hex": "bb2100000101e020"})
+        with self.assertRaisesRegex(ValueError, "at least 8 bytes"):
+            gateway_server.parse_raw_request({"side": "right", "hex": "aa210000"})
+        # header says 0x13 (19) payload bytes but only 2 follow
+        with self.assertRaisesRegex(ValueError, "does not match header length"):
+            gateway_server.parse_raw_request({"side": "right", "hex": "aa219213010101200802"})
+        # two concatenated frames in one hex string
+        with self.assertRaisesRegex(ValueError, "separate frames"):
+            gateway_server.parse_raw_request({"side": "right", "hex": PRELUDE_HEX + PRELUDE_HEX})
+
+    def test_rejects_missing_or_mixed_payload(self) -> None:
+        with self.assertRaisesRegex(ValueError, "requires hex or frames"):
+            gateway_server.parse_raw_request({"side": "right"})
+        with self.assertRaisesRegex(ValueError, "not both"):
+            gateway_server.parse_raw_request({"side": "right", "hex": PRELUDE_HEX, "frames": [PRELUDE_HEX]})
+        with self.assertRaisesRegex(ValueError, "non-empty list"):
+            gateway_server.parse_raw_request({"side": "right", "frames": []})
+        with self.assertRaisesRegex(ValueError, "must be a JSON object"):
+            gateway_server.parse_raw_request([PRELUDE_HEX])
+
+    def test_validate_raw_frame_returns_same_bytes(self) -> None:
+        raw = bytes.fromhex(PRELUDE_HEX)
+        self.assertEqual(validate_raw_frame(bytearray(raw)), raw)
+
+
+class _FakeRequest:
+    def __init__(self, payload) -> None:
+        self._payload = payload
+
+    async def json(self):
+        if isinstance(self._payload, Exception):
+            raise self._payload
+        return self._payload
+
+
+class _FakeClient:
+    def __init__(self, connected: bool = True) -> None:
+        self.connected = connected
+        self.calls: list[tuple[str, list[bytes], bool]] = []
+
+    async def write_raw_frames(self, side: str, frames, response: bool = False):
+        if not self.connected:
+            raise G2NotConnectedError(f"{side} G2 lens is not connected")
+        self.calls.append((side, list(frames), response))
+        return {"accepted": True, "side": side, "bytes": sum(len(f) for f in frames), "frames": len(frames)}
+
+
+def _make_app() -> gateway_server.GatewayServerApp:
+    tmp = tempfile.mkdtemp()
+    config = GatewayConfig()
+    config.gui.enabled = False
+    return gateway_server.GatewayServerApp(config=config, config_store=GatewayConfigStore(Path(tmp) / "gateway.yaml"))
+
+
+class RawEndpointTests(unittest.IsolatedAsyncioTestCase):
+    async def test_accepted_write(self) -> None:
+        app = _make_app()
+        fake = _FakeClient()
+        app._client = fake  # type: ignore[assignment]
+
+        response = await app.handle_raw(_FakeRequest({"side": "both", "hex": PRELUDE_HEX}))
+
+        self.assertEqual(response.status, 200)
+        body = json.loads(response.text)
+        self.assertEqual(body, {"accepted": True, "side": "both", "bytes": 27, "frames": 1})
+        self.assertEqual(fake.calls, [("both", [bytes.fromhex(PRELUDE_HEX)], False)])
+
+    async def test_bad_hex_is_400(self) -> None:
+        app = _make_app()
+        app._client = _FakeClient()  # type: ignore[assignment]
+
+        response = await app.handle_raw(_FakeRequest({"side": "right", "hex": "nothex"}))
+
+        self.assertEqual(response.status, 400)
+        body = json.loads(response.text)
+        self.assertFalse(body["accepted"])
+        self.assertIn("error", body)
+
+    async def test_bad_json_is_400(self) -> None:
+        app = _make_app()
+        app._client = _FakeClient()  # type: ignore[assignment]
+
+        response = await app.handle_raw(_FakeRequest(json.JSONDecodeError("bad", "", 0)))
+
+        self.assertEqual(response.status, 400)
+
+    async def test_not_connected_is_409(self) -> None:
+        app = _make_app()
+        app._client = _FakeClient(connected=False)  # type: ignore[assignment]
+
+        response = await app.handle_raw(_FakeRequest({"side": "left", "hex": PRELUDE_HEX}))
+
+        self.assertEqual(response.status, 409)
+        body = json.loads(response.text)
+        self.assertFalse(body["accepted"])
+        self.assertIn("not connected", body["error"])
+
+    async def test_status_payload_exposes_new_fields(self) -> None:
+        app = _make_app()
+        payload = app.status_payload()
+        self.assertIn("park_on_exit", payload["server"])
+        self.assertIn("raw_events", payload["server"])
+        self.assertIn("parked", payload["glasses"])
+        self.assertIn("display_surface", payload["glasses"])
+
+
+class ClientRawWriteTests(unittest.IsolatedAsyncioTestCase):
+    def _client(self) -> tuple[G2Client, FakeBleakClient, FakeBleakClient]:
+        client = G2Client(G2ClientConfig(ble_packet_gap_ms=0))
+        left, right = FakeBleakClient("left"), FakeBleakClient("right")
+        client._left_client = left
+        client._right_client = right
+        client._state.left.connected = True
+        client._state.right.connected = True
+        return client, left, right
+
+    async def test_writes_each_frame_unchanged_to_requested_arm(self) -> None:
+        client, left, right = self._client()
+        frames = [bytes.fromhex(PRELUDE_HEX), bytes.fromhex(KEEPALIVE_HEX)]
+
+        result = await client.write_raw_frames("right", frames)
+
+        self.assertEqual(result, {"accepted": True, "side": "right", "bytes": 27 + 16, "frames": 2})
+        self.assertEqual([w[1] for w in right.writes], frames)
+        self.assertTrue(all(w[0] == CHAR_WRITE and w[2] is False for w in right.writes))
+        self.assertEqual(left.writes, [])
+
+    async def test_both_and_response_flag(self) -> None:
+        client, left, right = self._client()
+
+        await client.write_raw_frames("both", [bytes.fromhex(PRELUDE_HEX)], response=True)
+
+        self.assertEqual(len(left.writes), 1)
+        self.assertEqual(len(right.writes), 1)
+        self.assertTrue(left.writes[0][2])
+        self.assertTrue(right.writes[0][2])
+
+    async def test_disconnected_arm_raises_not_connected(self) -> None:
+        client, left, _ = self._client()
+        left.is_connected = False
+
+        with self.assertRaises(G2NotConnectedError):
+            await client.write_raw_frames("left", [bytes.fromhex(PRELUDE_HEX)])
+        with self.assertRaises(G2NotConnectedError):
+            await client.write_raw_frames("both", [bytes.fromhex(PRELUDE_HEX)])
+        # the healthy arm still works
+        await client.write_raw_frames("right", [bytes.fromhex(PRELUDE_HEX)])
+
+    async def test_no_client_at_all_raises_not_connected(self) -> None:
+        client = G2Client(G2ClientConfig())
+        with self.assertRaises(G2NotConnectedError):
+            await client.write_raw_frames("right", [bytes.fromhex(PRELUDE_HEX)])
+
+    async def test_invalid_side_or_frame_raises_value_error(self) -> None:
+        client, _, _ = self._client()
+        with self.assertRaises(ValueError):
+            await client.write_raw_frames("up", [bytes.fromhex(PRELUDE_HEX)])
+        with self.assertRaises(ValueError):
+            await client.write_raw_frames("right", [b"\xaa\x21"])
+        with self.assertRaises(ValueError):
+            await client.write_raw_frames("right", [])
+
+
+if __name__ == "__main__":
+    unittest.main()
