+    expected = RAW_FRAME_MIN_LENGTH + frame[3]
+    if len(frame) != expected:
+        raise ValueError(
+            f"frame length {len(frame)} does not match header length byte "
+            f"(expected {expected} bytes); send multi-packet messages as separate frames"
+        )
+    return bytes(frame)
 
 
