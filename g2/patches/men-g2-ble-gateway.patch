+class ForegroundLaunchTests(unittest.IsolatedAsyncioTestCase):
+    """Live capture 2026-10-23 (fw 2.3.2.14): picking the gateway entry while parked sends no
+    cmd 17, only a SID 0x0D foreground push of app 0xE0 followed by OS events 5/7."""
+
+    FG_EXIT = bytes.fromhex("aa123a0a0101e00108026a041a0208057bdb")  # 0xE0 cmd 2, OS event 5
+    FG_EVEN_HUB = bytes.fromhex("aa12140901010d0108011a0308e001d957")  # 0x0D {1:1, 3:{1:224}}
+    SYS_EXIT = bytes.fromhex("aa12370e0101e00108026a081a060807200128008121")  # 0xE0 cmd 2, OS event 7
+    FG_NONE = bytes.fromhex("aa12400601010d0108011a008bda")  # 0x0D {1:1, 3:{}}
+
+    async def _notify(self, h: Harness, frame: bytes) -> None:
+        gen = h.client._connection_generation
+        await h.client._handle_notification(frame, "R", "5402", gen, h.client._side_generations["right"])
+
+    def test_parse_gesture_ctrl_frames(self) -> None:
+        from mentraos.g2.events import parse_gesture_ctrl_response
+
+        self.assertEqual(parse_gesture_ctrl_response(self.FG_EVEN_HUB[8:-2]), {"foreground": True, "app_id": 224})
+        self.assertEqual(parse_gesture_ctrl_response(self.FG_NONE[8:-2]), {"foreground": True, "app_id": None})
+        self.assertEqual(parse_gesture_ctrl_response(b"\x08\x02"), {"foreground": False, "app_id": None})
+
+    async def test_capture_sequence_launches_and_ignores_the_empty_page_exit(self) -> None:
+        h = Harness(park_on_exit=True)
+        h.state.page.last_display_request = {"text": "weather"}
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+        self.assertTrue(h.state.parked)
+        self.assertTrue(h.client._heartbeat_paused())
+        h.client._last_park_monotonic -= 10.0  # the user picks the entry later, not as a shutdown echo
+        h.events.clear()
+        h.sent.clear()
+
+        for frame in (self.FG_EXIT, self.FG_EVEN_HUB, self.SYS_EXIT, self.FG_NONE):
+            await self._notify(h, frame)
+
+        self.assertFalse(h.state.parked)
+        self.assertFalse(h.client._heartbeat_paused())
+        self.assertEqual(h.state.display_surface, DISPLAY_SURFACE_APP, "system_exit inside the grace window must not reset the surface")
+        self.assertEqual(h.sent_cmds(), [int(EvenHubCmd.CREATE_STARTUP_PAGE)])
+        self.assertEqual(h.state.page.current_text_content, "weather")
+        launched = [d for d in h.kinds("glasses.dashboard") if d["action"] == "launched"]
+        self.assertEqual(launched, [{"action": "launched", "app_id": 224, "via": "foreground", "was_parked": True}])
+        reinit = h.kinds("system.reinitialize")
+        self.assertEqual(len(reinit), 1)
+        self.assertEqual(reinit[0]["reason"], "dashboard_launch")
+        self.assertEqual(reinit[0]["app_id"], 224)
+        # the touch events are still surfaced to hosts, just not acted on
+        self.assertEqual([t["gesture"] for t in h.kinds("glasses.touch")], ["foreground_exit", "system_exit"])
+
+    async def test_system_exit_after_grace_window_is_handled_normally(self) -> None:
+        h = Harness(park_on_exit=True)
+        await h.client._handle_even_hub_payload(page_shutdown_payload(9))
+        h.client._last_park_monotonic -= 10.0
+        await self._notify(h, self.FG_EVEN_HUB)
+        self.assertFalse(h.state.parked)
+        h.client._last_launch_monotonic -= 5.0  # pretend the launch was 5 s ago
+
+        await self._notify(h, self.SYS_EXIT)
