diff --git a/tests/_support.py b/tests/_support.py
new file mode 100644
index 0000000..9024cde
--- /dev/null
+++ b/tests/_support.py
@@ -0,0 +1,92 @@
+"""Shared helpers for gateway tests (fake BLE clients, protobuf payload builders).
+
+test_gateway_mcp.py installs stub ``aiohttp`` / ``PIL`` modules into ``sys.modules``
+at import time. Tests that need the real packages call ``restore_real_modules()``
+first so ``gateway_server`` and ``mentraos.g2`` bind the genuine implementations.
+"""
+
+from __future__ import annotations
+
+import sys
+from typing import Any
+
+from mentraos.g2.protobuf import ProtobufReader, ProtobufWriter
+
+
+def restore_real_modules() -> None:
+    """Drop spec-less stub modules so the next import loads the real package."""
+
+    for name in list(sys.modules):
+        if name == "aiohttp" or name.startswith("aiohttp.") or name == "PIL" or name.startswith("PIL."):
+            module = sys.modules[name]
+            if getattr(module, "__spec__", None) is None:
+                del sys.modules[name]
+
+
+class FakeBleakClient:
+    """Records write_gatt_char calls instead of touching Bluetooth."""
+
+    def __init__(self, side: str) -> None:
+        self.side = side
+        self.is_connected = True
+        self.writes: list[tuple[Any, bytes, bool]] = []
+
+    async def write_gatt_char(self, char: Any, data: bytes, response: bool = False) -> None:
+        self.writes.append((char, bytes(data), response))
+
+    async def disconnect(self) -> None:
+        self.is_connected = False
+
+
+def even_hub_cmd(payload: bytes) -> int | None:
+    """Return field 1 (cmd) of an EvenHub message built by the gateway."""
+
+    value = ProtobufReader(payload).parse_fields().get(1)
+    return value if isinstance(value, int) else None
+
+
+def page_shutdown_payload(cmd: int = 9) -> bytes:
+    """Glasses -> phone EvenHub cmd 9/10 (page torn down)."""
+
+    writer = ProtobufWriter()
+    writer.write_int32_field(1, cmd)
+    return writer.to_bytes()
+
+
+def sys_event_payload(event_type: int, source: int = 1) -> bytes:
+    """Glasses -> phone OS_NOTIFY_EVENT_TO_APP with a sysEvent of the given type."""
+
+    sys_writer = ProtobufWriter()
+    sys_writer.write_int32_field(1, event_type)
+    sys_writer.write_int32_field(2, source)
+    dev_event = ProtobufWriter()
+    dev_event.write_message_field(3, sys_writer.to_bytes())
+    writer = ProtobufWriter()
+    writer.write_int32_field(1, 2)
+    writer.write_message_field(13, dev_event.to_bytes())
+    return writer.to_bytes()
+
+
+def text_event_payload(event_type: int, container_id: int = 1) -> bytes:
+    """Glasses -> phone text-container event of the given type."""
+
+    text_writer = ProtobufWriter()
+    text_writer.write_int32_field(1, container_id)
+    text_writer.write_int32_field(3, event_type)
+    dev_event = ProtobufWriter()
+    dev_event.write_message_field(2, text_writer.to_bytes())
+    writer = ProtobufWriter()
+    writer.write_int32_field(1, 2)
+    writer.write_message_field(13, dev_event.to_bytes())
+    return writer.to_bytes()
+
+
+def menu_select_payload(app_id: int) -> bytes:
+    """Glasses -> phone cmd 17 (dashboard menu item chosen)."""
+
+    select = ProtobufWriter()
+    select.write_int32_field(1, app_id)
+    writer = ProtobufWriter()
+    writer.write_int32_field(1, 17)
+    writer.write_message_field(20, select.to_bytes())
+    return writer.to_bytes()
