+def parse_gesture_ctrl_response(payload: bytes) -> Dict[str, Any]:
+    """Parse a glasses -> phone SID 0x0D (GESTURE_CTRL) frame.
+
+    Observed on firmware 2.3.2.14: ``{1: 1, 3: {1: <app id>}}`` when an app is pushed to
+    the foreground (0xE0 = EvenHub, i.e. the gateway's own entry) and ``{1: 1, 3: {}}``
+    when the foreground goes back to nothing / the dashboard. Returns
+    ``{"foreground": True, "app_id": int | None}``; unknown shapes give ``foreground=False``.
+    """
+
+    result: Dict[str, Any] = {"foreground": False, "app_id": None}
+    fields = ProtobufReader(payload).parse_fields()
+    if fields.get(1) != 1:
+        return result
+    result["foreground"] = True
+    nested = fields.get(3)
+    if isinstance(nested, (bytes, bytearray)):
+        app_id = ProtobufReader(bytes(nested)).parse_fields().get(1)
+        if isinstance(app_id, int):
+            result["app_id"] = app_id
+    return result
+
+
